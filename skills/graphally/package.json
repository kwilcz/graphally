{
  "name": "graphally",
  "version": "2.19.1",
  "description": "The engine that renders AI-generated technical diagrams to SVG, from HTML and CSS. Also an agent skill. Architecture with Azure and AWS icons, networks, BPMN, sequences, plans and any figure a web page can hold.",
  "keywords": ["diagram", "svg", "architecture", "azure", "aws", "bpmn", "sequence-diagram", "gantt", "agent-skill", "ai", "llm"],
  "homepage": "https://github.com/kwilcz/graphally",
  "repository": { "type": "git", "url": "git+https://github.com/kwilcz/graphally.git", "directory": "skills/graphally" },
  "bugs": "https://github.com/kwilcz/graphally/issues",
  "license": "Apache-2.0",
  "author": "Kamil Wilczyński (https://github.com/kwilcz)",
  "type": "module",
  "bin": { "graphally": "scripts/graphally.mjs" },
  "exports": {
    ".": "./scripts/lib/api.mjs",
    "./engine": "./scripts/lib/index.js",
    "./edits": "./scripts/lib/edits.mjs",
    "./viewer": "./viewer/graphally.min.js",
    "./theme.css": "./assets/theme.css",
    "./package.json": "./package.json"
  },
  "files": ["scripts", "viewer", "assets/theme.css", "assets/icon-sources", "references", "SKILL.md", "LICENSE.txt", "NOTICE.txt"],
  "engines": { "node": ">=18" }
